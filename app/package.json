{
  "name": "engenharia360-offline-app",
  "version": "0.2.0-p1.0",
  "private": true,
  "description": "CompatibilizaBIM Studio Preview — conversão DWG/IFC, revisão e histórico offline",
  "author": "Artificial Solution",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:p1:windows": "npm run build && electron-builder --config electron-builder.p1.config.cjs --win nsis --publish never"
  },
  "dependencies": {
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "wait-on": "^8.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.artisys.compatibilizabim.studio.preview",
    "productName": "CompatibilizaBIM Studio Preview",
    "directories": {
      "output": "dist-installers"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "../storage/**/*",
      "../src/**/*",
      "../modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../runtime_min/python",
        "to": "runtime"
      },
      {
        "from": "../runtime_min/acadsharp",
        "to": "bridges/acadsharp"
      },
      {
        "from": "../modules",
        "to": "modules"
      },
      {
        "from": "../integrations/cbim-2.1.0",
        "to": "integrations/cbim-2.1.0",
        "filter": [
          "**/*",
          "!**/tests/**",
          "!**/benchmarks/**",
          "!**/*.md",
          "!**/__pycache__/**",
          "!**/bin/**",
          "!**/obj/**",
          "!**/build/**",
          "!**/dist/**"
        ]
      }
    ],
    "compression": "store",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "CompatibilizaBIM-Studio-P1-Setup-${version}.${ext}",
    "asar": true
  }
}
